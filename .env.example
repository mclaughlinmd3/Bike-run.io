# --- Client-side (Vite embeds anything prefixed VITE_ into the browser bundle) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_STRAVA_CLIENT_ID=your-strava-client-id

# --- Server-side only (Vercel serverless functions under api/, never sent to the browser) ---
# Same project as above, just without the VITE_ prefix so it doesn't get bundled client-side.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
STRAVA_CLIENT_ID=your-strava-client-id
STRAVA_CLIENT_SECRET=your-strava-client-secret
